<%- include('../partials/header') %>
<h3 class="mb-3">학사 일정</h3>
<div class="card shadow-sm mb-4">
  <table class="table mb-0 align-middle">
    <thead class="table-light"><tr><th style="width:230px">기간</th><th>일정</th><th>설명</th><th style="width:80px"></th></tr></thead>
    <tbody>
    <% if (schedules.length === 0) { %><tr><td colspan="4" class="text-center text-muted py-4">등록된 일정이 없어요.</td></tr><% } %>
    <% schedules.forEach(function(s) { %>
      <tr>
        <td><%= new Date(s.start_date).toLocaleDateString('ko-KR') %> ~ <%= new Date(s.end_date).toLocaleDateString('ko-KR') %></td>
        <td class="fw-bold"><%= s.title %></td>
        <td class="text-muted small"><%= s.description || '' %></td>
        <td><% if (user && user.role === 'admin') { %>
          <form method="post" action="/dept/schedule/<%= s.id %>/delete" onsubmit="return confirm('삭제할까요?')">
            <button class="btn btn-sm btn-outline-danger">삭제</button></form>
        <% } %></td>
      </tr>
    <% }); %>
    </tbody>
  </table>
</div>
<% if (user && user.role === 'admin') { %>
<div class="card shadow-sm"><div class="card-body">
  <h6>일정 등록 (관리자)</h6>
  <form class="row g-2" method="post" action="/dept/schedule">
    <div class="col-md-4"><input class="form-control" name="title" placeholder="일정 제목" required></div>
    <div class="col-md-2"><input type="date" class="form-control" name="start_date" required></div>
    <div class="col-md-2"><input type="date" class="form-control" name="end_date"></div>
    <div class="col-md-4"><input class="form-control" name="description" placeholder="설명 (선택)"></div>
    <div class="col-12"><button class="btn btn-primary">등록</button></div>
  </form>
</div></div>
<% } %>
<%- include('../partials/footer') %>
