<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>정보통신공학과 카페</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">정보통신공학과 카페</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">학과 소개</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/dept/about">학과 소개</a></li>
            <li><a class="dropdown-item" href="/dept/professors">교수진</a></li>
            <li><a class="dropdown-item" href="/dept/curriculum">교육과정</a></li>
            <li><a class="dropdown-item" href="/dept/schedule">학사 일정</a></li>
          </ul>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">게시판</a>
          <ul class="dropdown-menu">
            <% boards.forEach(function(b) { %>
              <li><a class="dropdown-item" href="/boards/<%= b.slug %>"><%= b.name %></a></li>
            <% }); %>
          </ul>
        </li>
        <li class="nav-item"><a class="nav-link" href="/rental">장비 대여</a></li>
        <li class="nav-item"><a class="nav-link" href="/timetable">공강 매칭</a></li>
        <% if (user && user.role === 'admin') { %>
          <li class="nav-item"><a class="nav-link text-warning" href="/admin">관리자</a></li>
        <% } %>
      </ul>
      <ul class="navbar-nav">
        <% if (user) { %>
          <li class="nav-item"><span class="navbar-text me-3"><%= user.name %>님</span></li>
          <li class="nav-item"><a class="nav-link" href="/logout">로그아웃</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/login">로그인</a></li>
          <li class="nav-item"><a class="nav-link" href="/register">회원가입</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
<div class="container my-4">
