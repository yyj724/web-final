<%- include('partials/header') %>
<div class="p-5 mb-4 bg-white rounded-3 shadow-sm">
  <h1 class="display-6 fw-bold">정보통신공학과 카페</h1>
  <p class="lead mb-3">공지, 소통, 장비 대여, 공강 매칭까지 학과 생활을 한곳에서.</p>
  <a class="btn btn-primary me-2" href="/rental">장비 대여하기</a>
  <a class="btn btn-outline-primary" href="/timetable">공강 매칭하기</a>
</div>
<div class="row g-3">
  <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body">
    <h6 class="fw-bold">공지사항</h6>
    <% if (notices.length === 0) { %><p class="text-muted small mb-0">공지가 없어요.</p><% } %>
    <ul class="list-unstyled mb-0">
      <% notices.forEach(function(n) { %>
        <li class="py-1"><a class="text-decoration-none" href="/boards/notice/<%= n.id %>"><%= n.title %></a></li>
      <% }); %>
    </ul>
  </div></div></div>
  <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body">
    <h6 class="fw-bold">최신 글</h6>
    <% if (recent.length === 0) { %><p class="text-muted small mb-0">글이 없어요.</p><% } %>
    <ul class="list-unstyled mb-0">
      <% recent.forEach(function(p) { %>
        <li class="py-1"><span class="badge bg-secondary me-1"><%= p.board_name %></span>
          <a class="text-decoration-none" href="/boards/<%= p.slug %>/<%= p.id %>"><%= p.title %></a></li>
      <% }); %>
    </ul>
  </div></div></div>
  <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body">
    <h6 class="fw-bold">다가오는 학사 일정</h6>
    <% if (schedules.length === 0) { %><p class="text-muted small mb-0">등록된 일정이 없어요.</p><% } %>
    <ul class="list-unstyled mb-0">
      <% schedules.forEach(function(s) { %>
        <li class="py-1"><span class="text-muted small"><%= new Date(s.start_date).toLocaleDateString('ko-KR') %></span> <%= s.title %></li>
      <% }); %>
    </ul>
  </div></div></div>
</div>
<%- include('partials/footer') %>
