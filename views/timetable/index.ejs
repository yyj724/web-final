<%- include('../partials/header') %>
<h3 class="mb-3">공강 매칭</h3>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<div class="row g-3 mb-4">
  <div class="col-lg-7">
    <div class="card shadow-sm">
      <div class="card-header fw-bold">내 시간표</div>
      <div class="table-responsive">
        <table class="table table-bordered mb-0 text-center align-middle" style="table-layout:fixed;font-size:.8rem">
          <thead class="table-light"><tr>
            <th style="width:60px"></th>
            <% days.forEach(function(d) { %><th><%= d %></th><% }); %>
          </tr></thead>
          <tbody>
          <% grid.forEach(function(row, i) { %>
            <tr style="height:26px">
              <td class="text-muted"><%= i % 2 === 0 ? slotLabel(i) : '' %></td>
              <% row.forEach(function(cell) { %>
                <% if (cell) { %>
                  <td style="background:hsl(<%= (cell.entry.id * 47) % 360 %> 70% 85%)"><%= cell.first ? cell.entry.course_name : '' %></td>
                <% } else { %><td></td><% } %>
              <% }); %>
            </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card shadow-sm mb-3"><div class="card-body">
      <h6 class="fw-bold">수업 추가</h6>
      <form class="row g-2" method="post" action="/timetable/entries">
        <div class="col-4">
          <select class="form-select" name="day_of_week" required>
            <option value="1">월</option><option value="2">화</option><option value="3">수</option>
            <option value="4">목</option><option value="5">금</option>
          </select>
        </div>
        <div class="col-4"><input type="time" class="form-control" name="start_time" min="09:00" max="21:00" step="1800" required></div>
        <div class="col-4"><input type="time" class="form-control" name="end_time" min="09:00" max="21:00" step="1800" required></div>
        <div class="col-7"><input class="form-control" name="course_name" placeholder="과목명" required></div>
        <div class="col-5"><input class="form-control" name="room" placeholder="강의실"></div>
        <div class="col-12"><button class="btn btn-primary w-100">추가</button></div>
      </form>
      <div class="form-text">09:00 ~ 21:00 사이, 같은 시간대는 중복 등록할 수 없어요.</div>
    </div></div>

    <div class="card shadow-sm">
      <div class="card-header fw-bold">등록한 수업 <%= entries.length %>개</div>
      <ul class="list-group list-group-flush">
        <% if (entries.length === 0) { %><li class="list-group-item text-muted">등록된 수업이 없어요.</li><% } %>
        <% entries.forEach(function(e) { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>
              <strong><%= days[e.day_of_week - 1] %></strong>
              <%= String(e.start_time).slice(0, 5) %>~<%= String(e.end_time).slice(0, 5) %>
              <%= e.course_name %> <span class="text-muted small"><%= e.room || '' %></span>
            </span>
            <form method="post" action="/timetable/entries/<%= e.id %>/delete">
              <button class="btn btn-sm btn-outline-danger">삭제</button></form>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>
</div>

<h4 class="mb-3">모임 그룹</h4>
<div class="row g-3">
  <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body">
    <h6 class="fw-bold">그룹 만들기</h6>
    <form method="post" action="/timetable/groups">
      <input class="form-control mb-2" name="name" placeholder="그룹 이름 (예: 팀프로젝트 3조)" required>
      <button class="btn btn-primary w-100">만들기</button>
    </form>
    <hr>
    <h6 class="fw-bold">초대 코드로 참여</h6>
    <form method="post" action="/timetable/groups/join">
      <input class="form-control mb-2 text-uppercase" name="invite_code" placeholder="초대 코드 6자리" maxlength="10" required>
      <button class="btn btn-outline-primary w-100">참여하기</button>
    </form>
  </div></div></div>
  <div class="col-md-8"><div class="card shadow-sm h-100">
    <div class="card-header fw-bold">내 그룹</div>
    <ul class="list-group list-group-flush">
      <% if (groups.length === 0) { %><li class="list-group-item text-muted">참여 중인 그룹이 없어요.</li><% } %>
      <% groups.forEach(function(g) { %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span><strong><%= g.name %></strong> <span class="text-muted small">· <%= g.member_count %>명</span></span>
          <a class="btn btn-sm btn-primary" href="/timetable/groups/<%= g.id %>">공통 공강 보기</a>
        </li>
      <% }); %>
    </ul>
  </div></div>
</div>
<%- include('../partials/footer') %>
