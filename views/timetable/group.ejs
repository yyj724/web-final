<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0"><%= group.name %></h3>
  <a class="btn btn-outline-secondary" href="/timetable">← 내 시간표</a>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-5"><div class="card shadow-sm h-100"><div class="card-body">
    <div class="text-muted small">초대 코드 (친구에게 알려주세요)</div>
    <div class="fs-3 fw-bold text-primary" style="letter-spacing:4px"><%= group.invite_code %></div>
    <hr>
    <div class="fw-bold mb-2">그룹원 <%= total %>명</div>
    <% members.forEach(function(m) { %>
      <span class="badge <%= m.id === group.owner_id ? 'bg-primary' : 'bg-secondary' %> me-1 mb-1">
        <%= m.name %><%= m.id === group.owner_id ? ' (그룹장)' : '' %></span>
    <% }); %>
    <div class="mt-3">
      <% if (isOwner) { %>
        <form method="post" action="/timetable/groups/<%= group.id %>/delete" onsubmit="return confirm('그룹을 삭제할까요?')">
          <button class="btn btn-sm btn-outline-danger">그룹 삭제</button></form>
      <% } else { %>
        <form method="post" action="/timetable/groups/<%= group.id %>/leave" onsubmit="return confirm('그룹에서 나갈까요?')">
          <button class="btn btn-sm btn-outline-danger">그룹 나가기</button></form>
      <% } %>
    </div>
  </div></div></div>

  <div class="col-md-7"><div class="card shadow-sm h-100"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h6 class="fw-bold mb-0">전원 공통 공강</h6>
      <form class="d-flex gap-1 align-items-center" method="get">
        <span class="small text-muted">최소</span>
        <select class="form-select form-select-sm" name="min" onchange="this.form.submit()" style="width:100px">
          <% allowed.forEach(function(a) { %>
            <option value="<%= a %>" <%= a === minMinutes ? 'selected' : '' %>><%= fmtMin(a) %></option>
          <% }); %>
        </select>
      </form>
    </div>
    <% if (noTimetable.length > 0) { %>
      <div class="alert alert-warning py-2 small">
        시간표를 아직 입력하지 않은 그룹원이 있어요 (<%= noTimetable.map(function(m) { return m.name; }).join(', ') %>).
        이 경우 그 사람은 항상 비는 것으로 계산돼요.
      </div>
    <% } %>
    <% if (runs.length === 0) { %>
      <p class="text-muted mb-0">전원이 <%= fmtMin(minMinutes) %> 이상 함께 비는 시간이 없어요. 최소 길이를 줄여보세요.</p>
    <% } else { %>
      <% if (best) { %>
        <div class="alert alert-success py-2">
          가장 긴 공강: <strong><%= days[best.day] %>요일 <%= best.start %> ~ <%= best.end %></strong> (<%= fmtMin(best.minutes) %>)
        </div>
      <% } %>
      <ul class="list-group list-group-flush">
        <% runs.forEach(function(r) { %>
          <li class="list-group-item px-0 d-flex justify-content-between">
            <span><strong><%= days[r.day] %></strong> <%= r.start %> ~ <%= r.end %></span>
            <span class="text-muted"><%= fmtMin(r.minutes) %></span>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div></div></div>
</div>

<div class="card shadow-sm">
  <div class="card-header fw-bold d-flex justify-content-between">
    <span>그룹 시간표</span>
    <span class="small fw-normal">
      <span class="badge bg-success">공통 공강</span>
      <span class="badge bg-success-subtle text-dark">전원 비지만 너무 짧음</span>
      <span class="badge bg-secondary">숫자 = 수업 중인 인원</span>
    </span>
  </div>
  <div class="table-responsive">
    <table class="table table-bordered mb-0 text-center align-middle" style="table-layout:fixed;font-size:.8rem">
      <thead class="table-light"><tr>
        <th style="width:60px"></th>
        <% days.forEach(function(d) { %><th><%= d %></th><% }); %>
      </tr></thead>
      <tbody>
      <% for (let i = 0; i < SLOT_COUNT; i++) { %>
        <tr style="height:26px">
          <td class="text-muted"><%= i % 2 === 0 ? slotLabel(i) : '' %></td>
          <% for (let d = 0; d < 5; d++) { %>
            <% if (inRun[i][d]) { %>
              <td class="bg-success text-white">✓</td>
            <% } else if (busyCount[i][d] === 0) { %>
              <td class="bg-success-subtle"></td>
            <% } else { %>
              <td class="bg-light text-muted"><%= busyCount[i][d] %></td>
            <% } %>
          <% } %>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
