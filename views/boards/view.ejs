<%- include('../partials/header') %>
<div class="card shadow-sm mb-3"><div class="card-body">
  <div class="text-muted small mb-1"><a href="/boards/<%= board.slug %>"><%= board.name %></a></div>
  <h3><%= post.title %></h3>
  <div class="text-muted small mb-3">
    <%= post.author %> · <%= new Date(post.created_at).toLocaleString('ko-KR') %> · 조회 <%= post.views %>
  </div>
  <div style="white-space:pre-wrap"><%= post.content %></div>
  <hr>
  <div class="d-flex gap-2 align-items-center">
    <form method="post" action="/boards/<%= board.slug %>/<%= post.id %>/like">
      <button class="btn btn-sm <%= liked ? 'btn-danger' : 'btn-outline-danger' %>" <%= user ? '' : 'disabled' %>>
        ♥ 좋아요 <%= likeCount %></button>
    </form>
    <% if (user && (user.id === post.user_id || user.role === 'admin')) { %>
      <a class="btn btn-sm btn-outline-secondary" href="/boards/<%= board.slug %>/<%= post.id %>/edit">수정</a>
      <form method="post" action="/boards/<%= board.slug %>/<%= post.id %>/delete" onsubmit="return confirm('삭제할까요?')">
        <button class="btn btn-sm btn-outline-dark">삭제</button>
      </form>
    <% } %>
  </div>
</div></div>

<div class="card shadow-sm"><div class="card-body">
  <h6>댓글 <%= comments.length %></h6>
  <% comments.forEach(function(c) { %>
    <div class="border-bottom py-2">
      <div class="small text-muted"><%= c.author %> · <%= new Date(c.created_at).toLocaleString('ko-KR') %>
        <% if (user && (user.id === c.user_id || user.role === 'admin')) { %>
          <form class="d-inline" method="post" action="/boards/<%= board.slug %>/<%= post.id %>/comments/<%= c.id %>/delete">
            <button class="btn btn-link btn-sm text-danger p-0 ms-2">삭제</button></form>
        <% } %>
      </div>
      <div style="white-space:pre-wrap"><%= c.content %></div>
    </div>
  <% }); %>
  <% if (user) { %>
    <form class="mt-3" method="post" action="/boards/<%= board.slug %>/<%= post.id %>/comments">
      <textarea class="form-control mb-2" name="content" rows="2" placeholder="댓글을 입력하세요" required></textarea>
      <button class="btn btn-primary btn-sm">댓글 등록</button>
    </form>
  <% } else { %>
    <p class="text-muted mt-3 mb-0">댓글을 쓰려면 <a href="/login">로그인</a>하세요.</p>
  <% } %>
</div></div>
<%- include('../partials/footer') %>
