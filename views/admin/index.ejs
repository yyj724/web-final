<%- include('../partials/header') %>
<h3 class="mb-3">관리자 페이지</h3>
<div class="row g-3 mb-4">
  <div class="col-md-4"><div class="card shadow-sm text-center"><div class="card-body">
    <div class="text-muted small">회원 수</div><div class="fs-2 fw-bold"><%= counts.users %></div></div></div></div>
  <div class="col-md-4"><div class="card shadow-sm text-center"><div class="card-body">
    <div class="text-muted small">게시글 수</div><div class="fs-2 fw-bold"><%= counts.posts %></div></div></div></div>
  <div class="col-md-4"><div class="card shadow-sm text-center"><div class="card-body">
    <div class="text-muted small">댓글 수</div><div class="fs-2 fw-bold"><%= counts.comments %></div></div></div></div>
</div>
<div class="card shadow-sm">
  <div class="card-header fw-bold">회원 관리</div>
  <table class="table mb-0 align-middle">
    <thead class="table-light"><tr><th>학번</th><th>이름</th><th>이메일</th><th>학년</th><th style="width:220px">역할</th></tr></thead>
    <tbody>
    <% users.forEach(function(u) { %>
      <tr>
        <td><%= u.student_no %></td><td><%= u.name %></td><td><%= u.email %></td><td><%= u.grade || '-' %></td>
        <td>
          <% if (u.id === user.id) { %><span class="badge bg-danger">관리자 (본인)</span>
          <% } else { %>
            <form class="d-flex gap-1" method="post" action="/admin/users/<%= u.id %>/role">
              <select class="form-select form-select-sm" name="role">
                <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>학생</option>
                <option value="professor" <%= u.role === 'professor' ? 'selected' : '' %>>교수</option>
                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>관리자</option>
              </select>
              <button class="btn btn-sm btn-outline-primary">변경</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
